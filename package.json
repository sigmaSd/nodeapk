{
  "name": "@sigmasd/nodeapk",
  "version": "0.1.4",
  "description": "Package a Node app that serves its own UI as an Android APK: Node runs on the phone, the UI in a WebView",
  "keywords": [
    "android",
    "apk",
    "mobile",
    "node",
    "webview"
  ],
  "homepage": "https://github.com/sigmaSd/nodeapk",
  "bugs": "https://github.com/sigmaSd/nodeapk/issues",
  "license": "MIT",
  "author": "sigmaSd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmaSd/nodeapk.git"
  },
  "bin": {
    "nodeapk": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "shell/AndroidManifest.xml",
    "shell/classes.dex",
    "shell/classes.dex.key",
    "shell/kotlin",
    "shell/r8.pro",
    "shell/res"
  ],
  "type": "module",
  "scripts": {
    "prepack": "vp pack && node tools/prebuild-dex.ts",
    "demo": "node src/cli.ts build demo",
    "demo:install": "node src/cli.ts build demo --install"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.11.2"
}
